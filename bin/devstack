#!/usr/bin/env bash
# devstack — user-facing control CLI for the macOS dev stack.
# start|stop|restart|status|list|sites|add-site|sync|composer|ssl|update|doctor|version
set -uo pipefail

# Resolve package root even when invoked through a symlink (~/.local/bin/devstack).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
PKG_ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

. "$PKG_ROOT/lib/common.sh"
. "$PKG_ROOT/lib/modules.sh"
. "$PKG_ROOT/lib/sites.sh"
. "$PKG_ROOT/lib/ssl.sh"
. "$PKG_ROOT/lib/update.sh"

load_config
HELPER="${DEVSTACK_HELPER:-/usr/local/sbin/devstack-web}"

# ---------- actions ----------
svc_start() {
  local m="$1" out
  if [ "$m" = "web" ]; then
    sudo -n "$HELPER" start || { warn "web helper not installed (run install.sh) or sudo rule missing"; return 3; }
  else
    if ! out="$("$BREW" services start "$(module_formula "$m")" 2>&1)"; then
      warn "failed to start $m: $(printf '%s' "$out" | tail -2 | tr '\n' ' ')"
      return 1
    fi
  fi
}
svc_stop() {
  local m="$1" out
  if [ "$m" = "web" ]; then
    sudo -n "$HELPER" stop || return 3
  else
    if ! out="$("$BREW" services stop "$(module_formula "$m")" 2>&1)"; then
      warn "failed to stop $m: $(printf '%s' "$out" | tail -2 | tr '\n' ' ')"
      return 1
    fi
  fi
}

status_all() {
  local m
  for m in $MODULES_ALL; do
    printf '%s\t%s\t%s\n' "$m" "$(module_state "$m")" "$(module_detail "$m")"
  done
}

cmd_start()   { log "start ${1:-all}";  if [ -n "${1:-}" ]; then svc_start "$1"; else for m in $MODULES_START; do svc_start "$m"; done; svc_start web; fi; }
cmd_stop()    { log "stop ${1:-all}";   if [ -n "${1:-}" ]; then svc_stop "$1"; else for m in $MODULES_STOP; do svc_stop "$m"; done; fi; }
cmd_restart() { log "restart ${1:-all}"; if [ -n "${1:-}" ]; then svc_stop "$1"; svc_start "$1"; else cmd_stop; cmd_start; fi; }

cmd_sites() {
  if [ ! -f "$DEVSTACK_SITES_CONF" ]; then warn "no sites config at $DEVSTACK_SITES_CONF"; return 1; fi
  printf '%-22s %-10s %-45s %s\n' HOST PHP DOCROOT KIND
  sites_rows | while IFS=$'\t' read -r host docroot php kind aliases; do
    printf '%-22s %-10s %-45s %s\n' "$host" "$php" "$docroot" "$kind"
  done
}

cmd_add_site() {
  local host docroot php kind
  read -r -p "host (e.g. mysite.test): " host
  read -r -p "docroot (e.g. ~/Sites/mysite): " docroot
  read -r -p "php version [8.5]: " php; php="${php:-8.5}"
  read -r -p "kind [php]: " kind; kind="${kind:-php}"
  if [ -z "$host" ] || [ -z "$docroot" ]; then warn "host and docroot are required"; return 1; fi
  mkdir -p "$DEVSTACK_CONFIG_DIR"
  printf '%s | %s | %s | %s\n' "$host" "$docroot" "$php" "$kind" >> "$DEVSTACK_SITES_CONF"
  ok "added $host"
  sites_sync
  note "restart the web module to apply: devstack restart web"
}

cmd_doctor() {
  local fail=0
  info "dev-stack doctor"
  note "brew prefix: $HOMEBREW_PREFIX   user: $DEV_USER   ports: nginx ${NGINX_PORT} / apache ${APACHE_PORT}"

  info "formulae"
  for f in nginx httpd mysql@8.4 postgresql@18 redis mailpit php php@8.3 php@7.4 composer wp-cli; do
    if "$BREW" list --versions "$f" >/dev/null 2>&1; then ok "$f"; else warn "$f not installed"; fail=1; fi
  done

  info "services"
  for m in $MODULES_ALL; do
    local st; st="$(module_state "$m")"
    if [ "$st" = running ]; then ok "$m ($st)"; else warn "$m ($st)"; fail=1; fi
  done

  info "config syntax"
  local out
  out="$("$NGINX_BIN" -t 2>&1 || true)"
  case "$out" in *"syntax is ok"*) ok "nginx config valid" ;; *) warn "nginx config problem"; fail=1 ;; esac
  out="$("$APACHE_BIN" -t 2>&1 || true)"
  case "$out" in *"Syntax OK"*) ok "apache config valid" ;; *) warn "apache config problem"; fail=1 ;; esac

  info "privileged helper"
  if [ -x "$HELPER" ]; then ok "$HELPER"; else warn "helper not installed"; fail=1; fi

  info "update"
  local avail; avail="$(update_check json 0 2>/dev/null)"
  case "$avail" in
    *'"available":true'*) ok "a newer release is available (devstack update)" ;;
    *)                    ok "up to date ($DEVSTACK_VERSION)" ;;
  esac

  info "ssl"
  if ssl_enabled; then
    if [ -f "$DEVSTACK_CERT" ]; then ok "certificate present"; else warn "SSL on but no certificate"; fail=1; fi
    if ssl_ca_ok; then ok "mkcert CA trusted"; else warn "mkcert CA not trusted"; fail=1; fi
    if port_listening "$SSL_PORT"; then ok "listening :$SSL_PORT"; else warn "nothing on :$SSL_PORT"; fail=1; fi
  else
    note "disabled (enable with: devstack ssl enable)"
  fi

  info "sites"
  if [ -f "$DEVSTACK_SITES_CONF" ]; then
    local scheme="http" port="$NGINX_PORT" cacert=""
    if ssl_enabled; then scheme="https"; port="$SSL_PORT"; cacert="$(ssl_cacert)"; fi
    while IFS=$'\t' read -r host docroot php kind aliases; do
      local code
      if [ -n "$cacert" ] && [ -f "$cacert" ]; then
        code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 --cacert "$cacert" --resolve "$host:${port}:127.0.0.1" "$scheme://$host:$port/" 2>/dev/null)"
      else
        code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 --resolve "$host:${port}:127.0.0.1" "$scheme://$host:$port/" 2>/dev/null)"
      fi
      case "$code" in
        2*|3*) printf '  \033[1;32m✓\033[0m %-22s %s\n' "$host" "$code" ;;
        *)     printf '  \033[1;33m!\033[0m %-22s %s\n' "$host" "${code:-no-response}"; fail=1 ;;
      esac
    done < <(sites_rows)
  else
    warn "no sites config ($DEVSTACK_SITES_CONF)"; fail=1
  fi

  echo
  if [ "$fail" = 0 ]; then ok "all checks passed"; else warn "some checks failed (see above)"; fi
  return "$fail"
}

cmd_sync() {
  info "regenerating vhosts from sites.conf"
  sites_sync
  if sudo -n "$HELPER" start >/dev/null 2>&1; then ok "nginx reloaded + /etc/hosts synced"; else warn "helper unavailable (run install.sh) — reload nginx manually"; fi
  "$BREW" services restart httpd >/dev/null 2>&1 || true
  ok "synced"
}

php_bin_for() {
  case "$1" in
    8.5|8.5.*) echo "$HOMEBREW_PREFIX/opt/php/bin/php" ;;
    *)         echo "$HOMEBREW_PREFIX/opt/php@$1/bin/php" ;;
  esac
}

# The directory where composer.json usually lives (docroot, or its parent for */public).
project_root_of() {
  local d="$1"
  if [ "$(basename "$d")" = "public" ]; then dirname "$d"; else printf '%s' "$d"; fi
}

cmd_composer() {
  local site="" php="" want=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --site)   site="$2"; shift 2 ;;
      --site=*) site="${1#*=}"; shift ;;
      --php)    php="$2"; shift 2 ;;
      --php=*)  php="${1#*=}"; shift ;;
      --)       shift; while [ $# -gt 0 ]; do want+=("$1"); shift; done ;;
      *)        want+=("$1"); shift ;;
    esac
  done

  local docroot=""
  if [ -n "$site" ]; then
    local row; row="$(sites_rows | awk -F'\t' -v h="$site" '$1==h{print $2 "\t" $3; exit}')"
    [ -n "$row" ] || die "unknown site: $site  (see: devstack sites)"
    docroot="${row%%$'\t'*}"; php="${php:-${row##*$'\t'}}"
  fi

  # auto-detect from the current directory (site project root is an ancestor of $PWD)
  if [ -z "$docroot" ] && [ -z "$php" ]; then
    local h d p k a pr
    while IFS=$'\t' read -r h d p k a; do
      pr="$(project_root_of "$d")"
      case "$PWD/" in
        "$pr"/*) docroot="$d"; php="$p"; break ;;
      esac
    done < <(sites_rows)
  fi

  [ -n "$php" ] || php="8.5"
  local phpbin; phpbin="$(php_bin_for "$php")"
  [ -x "$phpbin" ] || die "PHP $php not installed ($phpbin)"

  local composer_bin; composer_bin="$(command -v composer || true)"
  [ -n "$composer_bin" ] || die "composer not found — run ./install.sh"

  # run where composer.json lives; default to the site's project root
  local workdir="$PWD"
  if [ -n "$docroot" ]; then
    workdir="$(project_root_of "$docroot")"
    local c
    for c in "$docroot" "$workdir"; do
      if [ -f "$c/composer.json" ]; then workdir="$c"; break; fi
    done
    [ -d "$workdir" ] || workdir="$docroot"
  fi

  info "composer · PHP $php · $workdir"
  cd "$workdir" || die "cannot cd to $workdir"
  "$phpbin" "$composer_bin" ${want[@]+"${want[@]}"}
}

reload_web() {
  if sudo -n "$HELPER" start >/dev/null 2>&1; then ok "nginx reloaded"; else warn "reload nginx manually (helper unavailable)"; fi
}

cmd_ssl() {
  local sub="${1:-status}"
  case "$sub" in
    status)
      info "SSL: $(ssl_summary)"
      if [ -f "$DEVSTACK_CERT" ]; then
        note "cert:    $DEVSTACK_CERT"
        note "expires: $("$OPENSSL" x509 -in "$DEVSTACK_CERT" -noout -enddate 2>/dev/null | cut -d= -f2)"
        note "sans:    $("$OPENSSL" x509 -in "$DEVSTACK_CERT" -noout -ext subjectAltName 2>/dev/null | tail -1 | sed 's/^ *//')"
      else
        note "no certificate issued yet"
      fi
      if ssl_ca_ok; then ok "mkcert CA trusted"; else warn "mkcert CA not trusted (run: devstack ssl enable)"; fi
      if port_listening "$SSL_PORT"; then ok "listening on :$SSL_PORT"; else note "nothing listening on :$SSL_PORT"; fi
      ;;
    enable)
      ssl_install_ca
      ssl_issue_cert
      set_config SSL 1
      SSL=1
      sites_sync
      reload_web
      ssl_app_urls https
      ok "HTTPS enabled — sites now redirect :$NGINX_PORT → :$SSL_PORT"
      ;;
    disable)
      set_config SSL 0
      SSL=0
      sites_sync
      reload_web
      ssl_app_urls http
      ok "HTTPS disabled — sites served over http only"
      ;;
    renew)
      ssl_issue_cert
      reload_web
      ok "certificate renewed"
      ;;
    *) die "usage: devstack ssl {enable|disable|status|renew}" ;;
  esac
}

cmd_update() {
  local check=0 json=0 yes=0 allow_helper=1 refresh=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --check)     check=1 ;;
      --json)      json=1 ;;
      --yes|-y)    yes=1 ;;
      --no-helper) allow_helper=0 ;;
      --refresh)   refresh=1 ;;
      --rollback)  update_rollback; return $? ;;
      -h|--help)   note "usage: devstack update [--check] [--json] [--refresh] [--yes] [--no-helper] | --rollback"; return 0 ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done
  if [ "$check" = "1" ]; then
    local mode="human"; [ "$json" = "1" ] && mode="json"
    update_check "$mode" "$refresh"
  else
    update_apply "$yes" "$allow_helper"
  fi
}

usage() {
  cat <<EOF
devstack $DEVSTACK_VERSION — local dev stack control

Usage: devstack <command> [module]

Commands:
  status                 show every module and its state
  start [module]         start all modules (or one)
  stop  [module]         stop all modules (or one)
  restart [module]       restart all modules (or one)
  list                   list module ids
  sites                  list configured sites
  add-site               interactively add a site
  sync                   regenerate vhosts + reload nginx/apache
  composer [opts] ...    run Composer with the site's PHP (--site HOST | --php VER)
  ssl {enable|disable|status|renew}   trusted HTTPS for all sites
  update [--check]       check for a new release (--check --json for the app)
  update --rollback      restore the previous version
  doctor                 verify services, configs, ports, helper, sites
  version                print version

Modules: mysql postgres redis mail php85 php83 php74 apache web
EOF
}

cmd="${1:-status}"; target="${2:-}"
case "$cmd" in
  status)  status_all ;;
  list)    for m in $MODULES_ALL; do echo "$m"; done ;;
  start)   [ -n "$target" ] && ! valid_module "$target" && die "unknown module: $target"; cmd_start "$target"; status_all ;;
  stop)    [ -n "$target" ] && ! valid_module "$target" && die "unknown module: $target"; cmd_stop  "$target"; status_all ;;
  restart) [ -n "$target" ] && ! valid_module "$target" && die "unknown module: $target"; cmd_restart "$target"; status_all ;;
  sites)   cmd_sites ;;
  add-site) cmd_add_site ;;
  sync)     cmd_sync ;;
  composer) shift; cmd_composer "$@" ;;
  ssl)      shift; cmd_ssl "$@" ;;
  update)   shift; cmd_update "$@" ;;
  doctor)  cmd_doctor ;;
  version|-v|--version) echo "devstack $DEVSTACK_VERSION" ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
